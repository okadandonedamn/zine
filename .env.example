# Supabaseプロジェクトの Settings > API からコピーする
# このファイルを .env.local にコピーして値を入れると、モックからSupabaseに切り替わる
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile の公開 site key。Supabase Auth 側でも CAPTCHA(Turnstile)を有効化する
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 本番URL(OGP・サイトマップに使用)。Vercelなら https://xxxx.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
